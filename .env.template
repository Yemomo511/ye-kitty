# OneBot 反向 WebSocket 共享密钥，需要与 NapCat Websocket客户端 URL 中的 access_token 保持一致。
YE_KITTY_ONEBOT_ACCESS_TOKEN=ye-kitty-local-secret

# NapCat 当前登录的机器人 QQ 号，用于过滤机器人自己发出的消息。
YE_KITTY_QQ_SELF_ID=

# 允许叶猫猫监听并回复的 QQ 群号列表，可以为空；请使用 [1231234, 23123123] 的形式填写。
YE_KITTY_QQ_GROUP_ALLOWLIST=[]

# 允许叶猫猫监听并回复的 QQ 好友号列表，可以为空；请使用 [1231234, 23123123] 的形式填写。
YE_KITTY_QQ_FRIEND_ALLOWLIST=[]

# Ye-Kitty 提供给 NapCat 连接的 OneBot 反向 WebSocket 服务监听地址，0.0.0.0 表示监听所有网卡。
YE_KITTY_ONEBOT_WS_HOST=0.0.0.0

# Ye-Kitty 提供给 NapCat 连接的 OneBot 反向 WebSocket 服务监听端口。
YE_KITTY_ONEBOT_WS_PORT=3001

# Ye-Kitty 提供给 NapCat 连接的 OneBot v11 反向 WebSocket 路径。
YE_KITTY_ONEBOT_WS_PATH=/onebot/v11

# OpenAI API Key；为空时使用默认回复，不调用模型。
OPENAI_API_KEY=

# OpenAI Agents SDK 使用的模型名称。
YE_KITTY_AGENT_MODEL=gpt-4.1-mini

# Agent 展示名称，会进入系统指令。
YE_KITTY_AGENT_NAME=叶猫猫

# Agent 回复超时时间，超过后回落默认回复。
YE_KITTY_AGENT_REPLY_TIMEOUT_MS=30000
