{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@kitty/shared/*": ["src/shared/*"],
      "@kitty/contracts/*": ["src/contracts/*"],
      "@kitty/services/*": ["src/services/*"],
      "@kitty/platforms/*": ["src/platforms/*"],
      "@kitty/control-plane/*": ["src/control-plane/*"],
      "@kitty/bootstrap/*": ["src/bootstrap/*"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
