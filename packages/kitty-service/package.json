{
  "name": "@ye-kitty/kitty-service",
  "version": "0.0.1",
  "private": true,
  "description": "Ye-Kitty service layer for platform events, persona policies, LLM decisions, and social actions.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx scripts/start.ts",
    "start-platform:qq": "tsx scripts/start-platform-qq.ts",
    "start-platform:xiaohongshu": "tsx scripts/start-platform-xiaohongshu.ts",
    "lint": "eslint .",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "eval:agent": "node --import tsx eval/index.ts",
    "eval:agent:warn": "node --import tsx eval/run-agent-eval-warn.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run validate:architecture && pnpm run typecheck && vitest run",
    "test:coverage:qq-harness": "vitest run src/services/agent-runtime/__test__/qq-harness-admission-queue.test.ts src/services/agent-runtime/__test__/qq-reply-event-subscriber.test.ts --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.include=src/services/agent-runtime/application/in-memory-qq-harness-admission-queue.ts --coverage.include=src/services/agent-runtime/application/qq-reply-event-subscriber.ts --coverage.thresholds.perFile --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.branches=80 --coverage.thresholds.statements=80",
    "test:coverage:code-agent": "vitest run src/services/llm/__test__/*.test.ts --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.include=src/services/llm/ --coverage.thresholds.perFile --coverage.thresholds.lines=80 --coverage.thresholds.functions=80 --coverage.thresholds.branches=80 --coverage.thresholds.statements=80"
  },
  "keywords": [
    "ye-kitty",
    "qq",
    "llm",
    "persona",
    "event-driven"
  ],
  "license": "ISC",
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "@openai/agents": "^0.12.0",
    "fastify": "^5.4.0",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "3.2.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
