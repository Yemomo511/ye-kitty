@@ -0,0 +1,22 @@
+package main
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestValidateMentionsResponse(t *testing.T) {
+	t.Run("接受网页原始 data 包装", func(t *testing.T) {
+		body := `{"success":true,"data":{"message_list":[],"has_more":false}}`
+		result, err := validateMentionsResponse(body)
+		require.NoError(t, err)
+		assert.JSONEq(t, body, string(result))
+	})
+
+	t.Run("拒绝非通知响应", func(t *testing.T) {
+		_, err := validateMentionsResponse(`{"success":true,"data":{}}`)
+		require.ErrorContains(t, err, "message_list")
+	})
+}

