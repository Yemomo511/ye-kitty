+// handleListMentions 处理通知中心被提及读取。
+// 结果保持页面接口的 JSON 结构，由下游平台适配器转为稳定事件。
+func (s *AppServer) handleListMentions(ctx context.Context) *MCPToolResult {
+	logrus.Info("MCP: 读取通知中心被提及提醒")
+
+	result, err := s.xiaohongshuService.ListMentions(ctx)
+	if err != nil {
+		return &MCPToolResult{
+			Content: []MCPContent{{
+				Type: "text",
+				Text: "读取被提及提醒失败: " + err.Error(),
+			}},
+			IsError: true,
+		}
+	}
+
+	return &MCPToolResult{Content: []MCPContent{{Type: "text", Text: string(result)}}}
+}
