+const mentionsEndpointPath = "/api/sns/web/v1/you/mentions"
+
+// ListMentions 打开通知中心并读取页面自身已签名的被提及接口响应。
+// Cookie 和请求签名始终由上游浏览器持有，工具不会拼装或输出任何凭据。
+func (s *XiaohongshuService) ListMentions(ctx context.Context) (json.RawMessage, error) {
+	b := newBrowser()
+	defer b.Close()
+
+	page := b.NewPage().Context(ctx)
+	defer page.Close()
+
+	type captureResult struct {
+		body       string
+		statusCode int
+		err        error
+	}
+	captured := make(chan captureResult, 1)
+	router := page.HijackRequests()
+	defer router.MustStop()
+	router.MustAdd("*"+mentionsEndpointPath+"*", func(hijack *rod.Hijack) {
+		if hijack.Request.Method() != http.MethodGet {
+			hijack.ContinueRequest(&proto.FetchContinueRequest{})
+			return
+		}
+		err := hijack.LoadResponse(http.DefaultClient, true)
+		result := captureResult{err: err}
+		if err == nil {
+			result.body = hijack.Response.Body()
+			result.statusCode = hijack.Response.Payload().ResponseCode
+		}
+		select {
+		case captured <- result:
+		default:
+		}
+	})
+	go router.Run()
+
+	if err := page.Navigate("https://www.xiaohongshu.com/notification"); err != nil {
+		return nil, fmt.Errorf("打开通知中心失败: %w", err)
+	}
+
+	select {
+	case result := <-captured:
+		if result.err != nil {
+			return nil, fmt.Errorf("读取被提及接口响应失败: %w", result.err)
+		}
+		if result.statusCode < 200 || result.statusCode >= 300 {
+			return nil, fmt.Errorf("被提及接口返回异常状态: status=%d bodyLength=%d", result.statusCode, len(result.body))
+		}
+		return validateMentionsResponse(result.body)
+	case <-ctx.Done():
+		return nil, fmt.Errorf("等待被提及接口超时: %w", ctx.Err())
+	}
+}
+
+// validateMentionsResponse 在返回前验证关键列表字段，避免登录页或风控页被当成通知。
+func validateMentionsResponse(body string) (json.RawMessage, error) {
+	var root map[string]json.RawMessage
+	if err := json.Unmarshal([]byte(body), &root); err != nil {
+		return nil, fmt.Errorf("被提及接口返回非法 JSON: %w", err)
+	}
+	container := root
+	if rawData, ok := root["data"]; ok {
+		if err := json.Unmarshal(rawData, &container); err != nil {
+			return nil, fmt.Errorf("被提及接口 data 结构无效: %w", err)
+		}
+	}
+	var messages []json.RawMessage
+	if rawMessages, ok := container["message_list"]; !ok {
+		return nil, fmt.Errorf("被提及接口缺少 message_list")
+	} else if err := json.Unmarshal(rawMessages, &messages); err != nil {
+		return nil, fmt.Errorf("被提及接口 message_list 结构无效: %w", err)
+	}
+	return json.RawMessage(body), nil
+}
